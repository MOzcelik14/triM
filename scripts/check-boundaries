#!/usr/bin/env bash
# Enforce crate dependency and module boundaries across the triM workspace.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

fail=0

# 1. Domain, media, and export crates must never import UI crates (trim-ui, egui, eframe, rfd).
#    trim-render bridges glow/egui textures and must not import trim-ui or rfd.
CORE_AND_MEDIA_CRATES=(
  trim-core
  trim-commands
  trim-timeline
  trim-project
  trim-media
  trim-export
)

for crate in "${CORE_AND_MEDIA_CRATES[@]}"; do
  if grep -rnE '(^|[^[:alnum:]_])(trim_ui|trim-ui|egui|eframe|rfd)([^[:alnum:]_]|$)' "crates/$crate/src" "crates/$crate/Cargo.toml" 2>/dev/null; then
    echo "BOUNDARY ERROR: core/media crate '$crate' references UI crate/dependency" >&2
    fail=1
  fi
done

if grep -rnE '(^|[^[:alnum:]_])(trim_ui|trim-ui|rfd)([^[:alnum:]_]|$)' crates/trim-render/src crates/trim-render/Cargo.toml 2>/dev/null; then
  echo "BOUNDARY ERROR: trim-render references trim-ui or rfd" >&2
  fail=1
fi

# 2. trim-core must remain at the bottom of the workspace dependency DAG.
if grep -rnE 'trim-(commands|timeline|project|media|render|export|ui|app)' crates/trim-core/Cargo.toml crates/trim-core/src 2>/dev/null; then
  echo "BOUNDARY ERROR: trim-core must not depend on higher-level workspace crates" >&2
  fail=1
fi

# 3. trim-ui must not spawn raw ffmpeg/ffprobe subprocesses directly;
#    only dialogs_dispatch.rs may spawn the OS file-manager opener (via TrackedChildPool).
while IFS= read -r hit; do
  file="${hit%%:*}"
  if [[ "$file" != "crates/trim-ui/src/app/dialogs_dispatch.rs" ]]; then
    echo "BOUNDARY ERROR: unexpected std::process::Command in trim-ui: $hit" >&2
    fail=1
  fi
done < <(grep -rn 'std::process::Command' crates/trim-ui/src/ 2>/dev/null || true)

if [[ "$fail" -ne 0 ]]; then
  exit 1
fi

echo "Boundary check passed: workspace DAG and trim-ui isolation are intact."
